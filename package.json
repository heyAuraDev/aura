        "format:fix": "prettier --write .",
        "lint:check": "eslint .",
        "lint:fix": "eslint --fix .",
        "prepare": "husky",
        "dev-test": "jest --verbose --detectOpenHandles",
        "test": "jest --verbose --detectOpenHandles --silent"
    },
    "dependencies": {
        "@google/generative-ai": "^0.21.0",
        "ambire-common": "github:AmbireTech/ambire-common#bbfd27031af432fd7a3db66ea401e51050fa0e7d",
        "openai": "^4.85.4",
        "tslib": "^2.8.1",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.17.0",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.13.1",
        "@typescript-eslint/eslint-plugin": "^8.19.1",
        "@typescript-eslint/parser": "^8.19.1",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "express": "^4.21.2",
        "globals": "^15.14.0",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "lint-staged": "^15.3.0",
        "nodemon": "^3.1.9",
        "prettier": "^3.4.2",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.3"
    },
